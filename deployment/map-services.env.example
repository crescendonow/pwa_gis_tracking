# Copy to deployment/map-services.env on the server and fill values locally.
# Never commit the populated file.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/pgweb_gis2
MONGO_URI=mongodb://USER:PASSWORD@HOST:27017/?authSource=admin
MONGO_DB_NAME=pwa_gis_tracking
MAP_MARTIN_URL=http://127.0.0.1:5031
MAP_MARTIN_SOURCE=pwa_gis_map_tile
MAP_SYNC_BATCH_SIZE=500
MAP_SYNC_CONCURRENCY=4
MAP_SYNC_PG_MAX_CONNS=8
MAP_WARM_CONCURRENCY=4
MAP_SYNC_CYCLE_TIMEOUT=14m
MAP_SYNC_COLLECTION_TIMEOUT=10m
# Web-service settings. Keep Google disabled until its official session proxy exists.
MAP_SATELLITE_PROVIDER=esri-osm
MAP_GOOGLE_TILE_PROXY_TEMPLATE=/pwa_gis_tracking/api/map/google/tiles/{z}/{x}/{y}
