# Copy to deployment/map-services.env on the server and fill values locally.
# Never commit the populated file.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/pgweb_gis2
MONGO_URI=mongodb://USER:PASSWORD@HOST:27017/?authSource=admin
MONGO_DB_NAME=pwa_gis_tracking
MAP_MARTIN_URL=http://127.0.0.1:5031
MAP_MARTIN_SOURCE=pwa_gis_map_tile
MAP_SYNC_BATCH_SIZE=500
MAP_SYNC_CONCURRENCY=4
MAP_SYNC_PG_MAX_CONNS=8
MAP_WARM_CONCURRENCY=4
MAP_SYNC_CYCLE_TIMEOUT=14m
MAP_SYNC_COLLECTION_TIMEOUT=10m
# "service" (default, long-running) or "backfill" (one unlimited cycle, then exit).
# -mode on the command line takes priority over this.
MAP_SYNC_MODE=service
# Region-level rollup collections (b{region}000_*) are stale 3x-duplicated
# snapshots; keep this false unless you are investigating S1's rollup removal.
MAP_SYNC_INCLUDE_ROLLUPS=false
# Bounds EnrichDMA/RefreshSummary/Warm, which run on a context detached from
# the cycle's own deadline so they are not skipped every cycle (see worker.go).
MAP_SYNC_FINALIZE_TIMEOUT=10m
# Optional: DMA colours live in pwa_dma.dma_boundary on a different server
# (192.168.242.38) than DATABASE_URL's mirror (10.250.230.81). If unset, DMA
# colour sync is skipped (logged at startup) and every DMA keeps rendering
# with the same fallback colour.
MAP_DMA_SOURCE_DATABASE_URL=postgres://USER:PASSWORD@192.168.242.38:5432/pgweb_gis2
# Web-service settings. Keep Google disabled until its official session proxy exists.
MAP_SATELLITE_PROVIDER=esri-osm
MAP_GOOGLE_TILE_PROXY_TEMPLATE=/pwa_gis_tracking/api/map/google/tiles/{z}/{x}/{y}
# Web service (not pwa-gis-map-sync): points /api/map/summary at the mirror
# database. Optional; falls back to the web service's own PgDB when unset or
# unreachable, and never blocks web service startup.
MAP_DATABASE_URL=postgres://USER:PASSWORD@10.250.230.81:5432/pgweb_gis2
